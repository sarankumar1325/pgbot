{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queryshift.dev/schema/queryshift-change-contract-1.0.json",
  "title": "QueryShift Change Contract",
  "description": "Immutable review and execution boundary for one guarded database statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "contract_sha256",
    "created_at",
    "target",
    "statement",
    "statement_sha256",
    "schema_sha256",
    "plan",
    "risk",
    "affected_objects",
    "verification",
    "evidence",
    "write_unlock_required"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^qsc_[0-9a-f]{16}$" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "proposer": { "type": "string", "minLength": 1 },
    "target": { "$ref": "#/$defs/target" },
    "statement": { "type": "string", "minLength": 1 },
    "statement_sha256": { "$ref": "#/$defs/sha256" },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "plan": { "$ref": "#/$defs/plan" },
    "risk": { "$ref": "#/$defs/risk" },
    "affected_objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/affectedObject" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verificationProbe" }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "write_unlock_required": { "const": true }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "fingerprint"],
      "properties": {
        "database": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "destructive",
        "versioned",
        "backup_required",
        "recovery_level",
        "recovery_note",
        "required_confirmation"
      ],
      "properties": {
        "kind": { "type": "string" },
        "summary": { "type": "string" },
        "destructive": { "type": "boolean" },
        "versioned": { "const": true },
        "backup_required": { "type": "boolean" },
        "recovery_level": { "type": "string" },
        "recovery_note": { "type": "string" },
        "rollback_sql": { "type": "string" },
        "required_confirmation": { "type": "string", "minLength": 5 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons", "lock_impact", "data_impact", "reversible", "backup_proof_required"],
      "properties": {
        "level": { "enum": ["controlled", "elevated", "high", "critical"] },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "lock_impact": { "type": "string" },
        "data_impact": { "type": "string" },
        "reversible": { "type": "boolean" },
        "backup_proof_required": { "type": "boolean" }
      }
    },
    "affectedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "operation"],
      "properties": {
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "operation": { "type": "string" }
      }
    },
    "verificationProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^VP[1-9][0-9]*$" },
        "kind": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sha256", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^CE[1-9][0-9]*$" },
        "kind": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "type": "string" }
      }
    }
  }
}
