# HELP queryshift_finding A queryshift finding (1 = present). suppressed="true" means muted by .queryshift.toml; destructive="true" means it carries a safety guard against a destructive action.
# TYPE queryshift_finding gauge
queryshift_finding{database="app",id="fsync_off",severity="critical",dimension="risk",object="setting:fsync",suppressed="false",preexisting="false",destructive="false"} 1
queryshift_finding{database="app",id="unused_indexes",severity="warn",dimension="storage",object="",suppressed="false",preexisting="false",destructive="false"} 1
queryshift_finding{database="app",id="io_timing_off",severity="info",dimension="throughput",object="setting:track_io_timing",suppressed="false",preexisting="false",destructive="false"} 1
queryshift_finding{database="app",id="checksums_disabled",severity="info",dimension="risk",object="setting:data_checksums",suppressed="true",preexisting="false",destructive="false"} 1
# HELP queryshift_findings_total Active (unsuppressed) findings by severity.
# TYPE queryshift_findings_total gauge
queryshift_findings_total{database="app",severity="critical"} 1
queryshift_findings_total{database="app",severity="warn"} 1
queryshift_findings_total{database="app",severity="info"} 1
# HELP queryshift_cache_hit_ratio Buffer cache hit ratio (0-1).
# TYPE queryshift_cache_hit_ratio gauge
queryshift_cache_hit_ratio{database="app"} 0.994
