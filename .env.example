# QueryShift local development configuration.
# Copy this file to .env, then uncomment and fill in one authentication option.
# The real .env is git-ignored and must never be committed.

AWS_REGION=us-east-1
# The TUI loads these model settings from .env. Existing shell variables win.
QUERYSHIFT_AI_PROVIDER=bedrock
QUERYSHIFT_AI_MODEL=deepseek.v3.2
QUERYSHIFT_AGENT_MODEL=deepseek.v3.2
QUERYSHIFT_BIN=./dist/local/bin/queryshift

# Agent resilience. The AWS SDK retries transport/service throttling first;
# QueryShift then retries only errors it can positively classify as transient.
QUERYSHIFT_BEDROCK_SDK_MAX_ATTEMPTS=5
QUERYSHIFT_AGENT_MAX_TRANSIENT_RETRIES=2
QUERYSHIFT_AGENT_RETRY_BASE_SECONDS=0.5
QUERYSHIFT_AGENT_RETRY_MAX_SECONDS=8

# Option A: short-lived credentials exported from AWS SSO or an assumed role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option B: a Bedrock API key.
# AWS_BEARER_TOKEN_BEDROCK=

# Needed only when grounding the agent against a live PostgreSQL-compatible DB.
# Use a dedicated read-only database user.
# DATABASE_URL=postgresql://queryshift_ro:password@host:5432/database?sslmode=require
